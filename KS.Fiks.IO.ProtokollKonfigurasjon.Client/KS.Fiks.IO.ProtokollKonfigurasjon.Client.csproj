<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>KS.Fiks.IO.ProtokollKonfigurasjon.Client</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>KS FIKS IO Protokoll Konfigurasjon Client</Title>
    <Authors>Ks-Kommunesektorens Organisasjon</Authors>
    <Copyright>Ks-Kommunesektorens Organisasjon</Copyright>
    <PackageProjectUrl>https://github.com/ks-no/fiks-io-client-dotnet</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>KS.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ks-no/fiks-io-client-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>FIKS</PackageTags>
    <VersionPrefix>7.1.1</VersionPrefix>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../fiks-io-strongly-named-key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../KS.Fiks.IO.Client/KS.png">
      <Pack>true</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../LICENSE">
      <Pack>true</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>true</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1" PrivateAssets="All" />
    <PackageReference Include="KS.Fiks.QA" Version="1.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Defaults to Net80 (matches TargetFramework). Override locally with /p:NSwagRuntime=Net100 on .NET 10-only machines. -->
    <NSwagRuntime Condition="'$(NSwagRuntime)' == ''">Net80</NSwagRuntime>
    <_NSwagCommand Condition="'$(NSwagRuntime)' == 'Net80'">$(NSwagExe_Net80)</_NSwagCommand>
    <_NSwagCommand Condition="'$(NSwagRuntime)' == 'Net90'">$(NSwagExe_Net90)</_NSwagCommand>
    <_NSwagCommand Condition="'$(NSwagRuntime)' == 'Net100'">$(NSwagExe_Net100)</_NSwagCommand>
    <!--
      Every per-TargetFramework build runs the NSwag target below, so a shared output path
      would be written concurrently by builds running in parallel. POSIX file semantics let
      concurrent writers replace a file without erroring, which is why that went unnoticed
      on Linux; Windows takes an exclusive lock and fails with "The process cannot access
      the file ... because it is being used by another process." Serializing this project's
      own inner builds is not enough: a referencing multi-targeted project (the test project
      targets net8.0 and net10.0) resolves the ProjectReference by invoking this project's
      inner build directly with TargetFramework as a global property, which bypasses the
      cross-targeting outer build entirely. Give each TargetFramework its own output path
      instead - $(IntermediateOutputPath) is already per-configuration and per-framework -
      so no two builds share a file. _NSwagOutput is computed inside the target below, not
      here: IntermediateOutputPath is defined by the common targets, which are imported
      after this project body is evaluated, so it is still empty at this point.
    -->
  </PropertyGroup>

  <!--
    Must run BeforeTargets="CoreCompile", not "Build": "Build" has no tasks of its own
    (just DependsOnTargets="BeforeBuild;CoreBuild;AfterBuild"), so a target with
    BeforeTargets="Build" only runs once CoreBuild (which includes CoreCompile) has
    already finished - i.e. after compilation, too late to provide the generated source.
    This previously went unnoticed only because the generated file was committed to the
    repo, so CoreCompile always had a (possibly stale) copy to compile regardless of
    whether/when this target ran. Runs unconditionally, including in CI (previously
    skipped when CI=true - set automatically by GitHub Actions - because the generated
    file used to be committed to work around unreliable network access on the Windows CI
    runner; see git history). The generated file now lands under obj/ and is never
    committed, so this target must always produce it before compilation. If NSwag fails to
    reach the OpenAPI spec URL it can exit 0 without writing the file, so we explicitly
    fail the build when the expected output is missing instead of surfacing a confusing
    CS0246. SDK-style implicit **/*.cs globbing captures @(Compile) items at project
    evaluation time, before any target runs - and excludes obj/ anyway - so the generated
    file must be added to @(Compile) explicitly once written.
  -->
  <Target Name="NSwag" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- Relative to this project directory, which is also the Exec working directory. -->
      <_NSwagOutput>$(IntermediateOutputPath)ProtokollKonfigurasjonClient.g.cs</_NSwagOutput>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="$(_NSwagCommand) run nswag.json /variables:NSwagRuntime=$(NSwagRuntime),Configuration=$(Configuration),NSwagOutput=$(_NSwagOutput)" />
    <Error Condition="!Exists('$(_NSwagOutput)')"
           Text="NSwag did not produce $(_NSwagOutput). Check the NSwag output above and network access to the OpenAPI spec URL in nswag.json." />
    <ItemGroup>
      <Compile Include="$(_NSwagOutput)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
